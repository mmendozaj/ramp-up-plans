# Copy this file to .env on the server and fill in the three secrets below.
# GITHUB_TOKEN: classic PAT from a separate write collaborator; see README.
# The configured Google Docs are public, so Google credentials are not needed.
GITHUB_REPOSITORY=mmendozaj/ramp-up-plans
GITHUB_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
