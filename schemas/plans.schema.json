{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ba-labs.example/schemas/ramp-up-plans.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "policy_defaults", "primes"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "version": {"type": "string", "minLength": 1},
    "policy_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hop_seconds", "max_change", "operating_cadence_seconds"],
      "properties": {
        "hop_seconds": {"type": "integer", "minimum": 1},
        "max_change": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
        "operating_cadence_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "primes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/prime"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["label", "visibility"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "url": {"type": "string"},
        "visibility": {"type": "string", "minLength": 1}
      }
    },
    "rateTarget": {
      "type": "object",
      "required": ["label", "max_amount_usd", "slope_per_day_usd"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "max_amount_usd": {
          "oneOf": [
            {"type": "number", "minimum": 0},
            {"const": "unlimited"}
          ]
        },
        "slope_per_day_usd": {"type": "number", "minimum": 0}
      }
    },
    "phase": {
      "type": "object",
      "required": ["id", "name", "rate_limit_targets"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "earliest_transition": {"type": "string", "format": "date"},
        "transition_window_end": {"type": "string", "format": "date"},
        "minimum_exposure_usd": {"type": "number", "minimum": 0},
        "minimum_exposure_days": {"type": "number", "minimum": 0},
        "minimum_phase_days": {"type": "number", "minimum": 0},
        "absolute_minimum_days": {"type": "number", "minimum": 0},
        "rate_limit_targets": {
          "type": "array",
          "items": {"$ref": "#/$defs/rateTarget"}
        }
      }
    },
    "track": {
      "type": "object",
      "required": ["id", "name", "facet", "sources", "phases"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "facet": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "phases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/phase"}}
      }
    },
    "prime": {
      "type": "object",
      "required": ["id", "name", "tracks"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "visible": {"type": "boolean"},
        "tracks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/track"}},
        "operator_programs": {"type": "array"}
      }
    }
  }
}
